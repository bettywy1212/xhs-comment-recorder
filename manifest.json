{
  "manifest_version": 3,
  "name": "小红帽 · 小红书评论记录器",
  "version": "0.6.0",
  "description": "你正常浏览小红书笔记时，被动记录页面已加载的评论和楼中楼回复，一键导出带图片的 Excel 或 CSV。不发出任何额外请求、不自动操作页面。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.xhscdn.com/*",
    "http://*.xhscdn.com/*",
    "https://*.xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "小红帽 · 小红书评论记录器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "lib/parse.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
